# Get a key at https://resend.com — free tier is plenty for a portfolio.
RESEND_API_KEY=

# Cloudflare Turnstile (free): https://dash.cloudflare.com/?to=/:account/turnstile
# Without these the form works locally with Cloudflare test keys,
# but production refuses to send.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
